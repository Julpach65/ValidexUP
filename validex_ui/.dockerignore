# .dockerignore para el Frontend (Next.js)
# Excluye archivos que NO deben entrar al contenedor

# Dependencias (se reinstalan dentro del contenedor)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build de Next.js
.next/
out/
build/

# Variables de entorno locales
.env
.env*.local

# Git
.git/
.gitignore

# Archivos de IDE
.vscode/
.idea/
*.swp

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# Archivos de TypeScript compilados
*.tsbuildinfo

# Logs
*.log
